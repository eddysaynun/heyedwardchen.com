---
import Layout from '../layouts/Layout.astro';
import T from '../components/T.astro';
import { getPublishedPosts } from '../utils/published';
import { sortPostsByPinnedAndDate } from '../utils/posts';
import Timeline from '../components/Timeline.astro';
import SearchResults from '../components/SearchResults.astro';
import Search from '../components/Search.astro';
import { t, DEFAULT_LANG } from '../utils/i18n';

const lang = DEFAULT_LANG;

// 获取所有博客文章
const allPosts = await getPublishedPosts();

// 使用工具函数排序
const posts = sortPostsByPinnedAndDate(allPosts);

// 提取所有标签
const tagCounts: Record<string, number> = {};
posts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const allTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([tag]) => tag);
---

<Layout title={t('blog.title', lang)}>
  <section class="hero rise">
    <div class="meta">
      <T tkey="blog.meta" />
    </div>

    <h1><T tkey="nav.blog" /></h1>

    <p class="lede"><T tkey="blog.lede" /></p>
  </section>

  <!-- Posts List with Search and Tags -->
  <section class="sec rise d2">
    <div class="sec-head">
      <h2>
        <T tkey="blog.list" />
      </h2>
      <span class="aux"><T tkey="tags.postCount" params={{ count: posts.length }} /></span>
    </div>
    
    <!-- Controls: Search + Tags -->
    <div class="controls">
      <Search placeholder={t('blog.searchPlaceholder', lang)} />
      <label class="sort-control"><span class="sr-only"><T tkey="blog.sort" /></span>
        <select id="post-sort" aria-label={t('blog.sort', lang)} data-i18n-aria-label="blog.sort">
          <option value="published" data-i18n="blog.newest">最近发布</option>
          <option value="updated" data-i18n="blog.updated">最近更新</option>
        </select>
      </label>
    </div>
    
    <div class="tags-wrapper">
      <div class="tags">
        <button class="tag active" data-tag="all">
          <T tkey="blog.all" />
          <span class="ct">({posts.length})</span>
        </button>
        {allTags.map((tag, index) => (
          <button class={`tag${index >= 10 ? ' hidden-tag' : ''}`} data-tag={tag}>
            {tag}
            <span class="ct">({tagCounts[tag]})</span>
          </button>
        ))}
      </div>
      {allTags.length > 10 && (
        <button id="toggle-tags" type="button" class="toggle-tags-btn">
          <span class="show-text"><T tkey="tags.expand" params={{ count: allTags.length - 10 }} /></span>
          <span class="hide-text" style="display: none;"><T tkey="tags.collapse" /></span>
        </button>
      )}
    </div>
    
    <SearchResults />
    <ol class="posts" id="posts-list">
      {posts.map((post) => (
        <li class={`post ${post.data.pinned ? 'pinned' : ''}`} data-tags={JSON.stringify(post.data.tags)} data-pinned={String(post.data.pinned)} data-published={post.data.pubDate?.getTime() ?? 0} data-updated={(post.data.updatedDate ?? post.data.pubDate)?.getTime() ?? 0}>
          <time class="date" datetime={post.data.pubDate?.toISOString() || ''}>
            {post.data.pubDate?.toLocaleDateString(lang) || t('common.unpublished', lang)}
          </time>
          <div class="body">
            <h3>
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h3>
            <p>{post.data.description}</p>
            {post.data.updatedDate && <small><T tkey="post.updated" /> <time datetime={post.data.updatedDate.toISOString()} data-i18n-date={post.data.updatedDate.toISOString()}>{post.data.updatedDate.toLocaleDateString(lang)}</time></small>}
            <div class="row">
              {post.data.tags.map((tag) => (
                <a href={`/blog?tag=${encodeURIComponent(tag)}`} 
                   class="pill"
                   aria-label={`查看 ${tag} 标签的文章`}>
                  {tag}
                </a>
              ))}
            </div>
          </div>
          <div class="meta-r">
            <span class="arrow">→</span>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Timeline Sidebar -->
  <Timeline posts={posts} />

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.tag[data-tag]');
    const list = document.querySelector<HTMLOListElement>('#posts-list');
    const posts = Array.from(document.querySelectorAll<HTMLElement>('#posts-list .post'));
    const sort = document.querySelector<HTMLSelectElement>('#post-sort');
    function applyFilters() {
      const params = new URL(location.href).searchParams;
      const tag = params.get('tag') || 'all';
      const order = params.get('sort') === 'updated' ? 'updated' : 'published';
      if (sort) sort.value = order;
      buttons.forEach(button => {
        const active = button.dataset.tag === tag;
        button.classList.toggle('on', active);
        button.setAttribute('aria-pressed', String(active));
        if (active) button.classList.remove('hidden-tag');
      });
      posts.sort((a, b) => Number(b.dataset.pinned === 'true') - Number(a.dataset.pinned === 'true') || Number(b.dataset[order]) - Number(a.dataset[order]));
      posts.forEach(post => {
        post.hidden = tag !== 'all' && !JSON.parse(post.dataset.tags!).includes(tag);
        list?.append(post);
      });
      document.dispatchEvent(new Event('blog:filter'));
    }
    buttons.forEach(button => button.addEventListener('click', () => {
      const url = new URL(location.href);
      if (button.dataset.tag === 'all') url.searchParams.delete('tag'); else url.searchParams.set('tag', button.dataset.tag!);
      history.pushState(null, '', url);
      applyFilters();
    }));
    sort?.addEventListener('change', () => {
      const url = new URL(location.href);
      if (sort.value === 'updated') url.searchParams.set('sort', 'updated'); else url.searchParams.delete('sort');
      history.pushState(null, '', url);
      applyFilters();
    });
    window.addEventListener('popstate', applyFilters);
    applyFilters();
  </script>

  <style>
    /* PC 端更宽的内容区域 */
    @media (min-width: 1024px) {
      .wrap {
        max-width: var(--col-wide);
      }
      
      .site-inner {
        max-width: var(--col-wide);
      }
    }
    
    .post[hidden], #posts-list[hidden] { display: none; }
    :global(.timeline-side[hidden]) { display: none; }
    .sort-control select { max-width: 130px; background: var(--bg); color: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: 8px; height: 38px; font-size: 12px; }
    small { color: var(--muted); }
    /* Controls row */
    .controls {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
    }

    /* Tags toggle */
    .tags-wrapper {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 18px;
    }

    .hidden-tag {
      display: none;
    }

    .toggle-tags-btn {
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.25rem 0.5rem;
      font-size: 0.75rem;
      color: var(--muted, #666);
      transition: color 0.2s;
      text-align: left;
    }

    .toggle-tags-btn:hover {
      color: var(--ink, #333);
    }
  </style>

  <script is:inline>
    (function() {
      const toggle = document.getElementById('toggle-tags');
      const tagsContainer = document.querySelector('.tags');
      if (!toggle || !tagsContainer) return;
      const showText = toggle.querySelector('.show-text');
      const hideText = toggle.querySelector('.hide-text');

      toggle.addEventListener('click', () => {
        const hidden = tagsContainer.querySelectorAll('.hidden-tag');
        if (hidden.length > 0) {
          hidden.forEach(t => t.classList.remove('hidden-tag'));
          if (showText) showText.style.display = 'none';
          if (hideText) hideText.style.display = '';
        } else {
          tagsContainer.querySelectorAll('.tag').forEach((t, i) => {
            if (i > 10 && !t.classList.contains('on')) t.classList.add('hidden-tag');
          });
          if (showText) showText.style.display = '';
          if (hideText) hideText.style.display = 'none';
        }
      });
    })();
  </script>
</Layout>
