---
// 右下角悬浮设置面板：主题 / 字体 / 密度
---

<div id="tweaks-panel" class="tweaks-panel">
  <button class="tweaks-toggle" type="button" aria-expanded="false" aria-controls="tweaks-menu" aria-label="自定义设置" data-i18n-aria-label="settings.customize">
    <svg width="16" height="16" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="3"></circle>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
    </svg>
  </button>
  <div id="tweaks-menu" class="tweaks-menu" role="region" aria-label="自定义设置" data-i18n-aria-label="settings.customize" inert>
    <div class="tweak-group">
      <span class="tweak-label" data-i18n="settings.theme">主题</span>
      <div class="tweak-options">
        <button class="tweak-option active" data-setting="theme" data-value="light" data-i18n="settings.theme.light">浅色</button>
        <button class="tweak-option" data-setting="theme" data-value="dark" data-i18n="settings.theme.dark">深色</button>
        <button class="tweak-option" data-setting="theme" data-value="auto" data-i18n="settings.theme.auto">跟随</button>
      </div>
    </div>
    <div class="tweak-group">
      <span class="tweak-label" data-i18n="settings.typeface">字体</span>
      <div class="tweak-options">
        <button class="tweak-option active" data-setting="typeface" data-value="sans" data-i18n="settings.typeface.sans">无衬线</button>
        <button class="tweak-option" data-setting="typeface" data-value="serif" data-i18n="settings.typeface.serif">衬线</button>
      </div>
    </div>
    <div class="tweak-group">
      <span class="tweak-label" data-i18n="settings.density">密度</span>
      <div class="tweak-options">
        <button class="tweak-option" data-setting="density" data-value="compact" data-i18n="settings.density.compact">紧凑</button>
        <button class="tweak-option active" data-setting="density" data-value="normal" data-i18n="settings.density.normal">正常</button>
        <button class="tweak-option" data-setting="density" data-value="comfy" data-i18n="settings.density.comfy">宽松</button>
      </div>
    </div>
    <div class="tweak-group">
      <span class="tweak-label" data-i18n="settings.language">语言</span>
      <div class="tweak-options">
        <button class="tweak-option active" data-setting="lang" data-value="zh-CN" data-i18n="settings.language.zh-CN">中文</button>
        <button class="tweak-option" data-setting="lang" data-value="en" data-i18n="settings.language.en">EN</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { t, translations, type Language, LANGS, DEFAULT_LANG } from '../utils/i18n';

  type Setting = 'theme' | 'typeface' | 'density' | 'lang';
  const STORAGE_KEY = (s: Setting) => `edwardchen-${s}`;

  function applyTheme(value: string) {
    if (value === 'auto') {
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
    } else {
      document.documentElement.setAttribute('data-theme', value);
    }
  }

  function applyLang(value: string) {
    const lang = (LANGS as readonly string[]).includes(value) ? (value as Language) : DEFAULT_LANG;
    document.documentElement.setAttribute('data-lang', lang);
    document.documentElement.setAttribute('lang', lang);

    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el => {
      const key = el.dataset.i18n!;
      if (!translations[key]) return;
      const raw = el.dataset.i18nParams;
      const params = raw ? JSON.parse(raw) as Record<string, string | number> : undefined;
      el.textContent = t(key, lang, params);
    });

    document.querySelectorAll<HTMLElement>('[data-i18n-aria-label]').forEach(el => {
      const key = el.dataset.i18nAriaLabel!;
      if (translations[key]) el.setAttribute('aria-label', t(key, lang));
    });

    document.querySelectorAll<HTMLElement>('[data-i18n-title]').forEach(el => {
      const key = el.dataset.i18nTitle!;
      if (!translations[key]) return;
      const raw = el.dataset.i18nParams;
      const params = raw ? JSON.parse(raw) as Record<string, string | number> : undefined;
      el.setAttribute('title', t(key, lang, params));
    });

    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-i18n-placeholder]').forEach(el => {
      const key = el.dataset.i18nPlaceholder!;
      if (translations[key]) el.setAttribute('placeholder', t(key, lang));
    });

    document.querySelectorAll<HTMLElement>('[data-i18n-date]').forEach(el => {
      const iso = el.dataset.i18nDate!;
      const format = el.dataset.i18nDateFormat || 'default';
      const date = new Date(iso);
      if (Number.isNaN(date.getTime())) return;
      const options = format === 'month-day'
        ? { month: 'numeric', day: 'numeric' } as Intl.DateTimeFormatOptions
        : undefined;
      el.textContent = date.toLocaleDateString(lang, options);
    });

    document.dispatchEvent(new CustomEvent('i18n:change', { detail: { lang } }));
  }

  function setActive(setting: Setting, value: string) {
    document.querySelectorAll(`[data-setting="${setting}"]`).forEach(opt => {
      const active = (opt as HTMLElement).dataset.value === value;
      opt.classList.toggle('active', active);
      opt.setAttribute('aria-pressed', String(active));
    });
  }

  function init() {
    const toggle = document.querySelector<HTMLElement>('.tweaks-toggle');
    const menu = document.querySelector<HTMLElement>('.tweaks-menu');
    if (!toggle || !menu) return;

    function setOpen(open: boolean) {
      menu!.classList.toggle('open', open);
      menu!.inert = !open;
      toggle!.setAttribute('aria-expanded', String(open));
    }
    toggle.addEventListener('click', () => setOpen(!menu.classList.contains('open')));
    document.addEventListener('click', event => {
      if (!(event.target as Element).closest('#tweaks-panel')) setOpen(false);
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.classList.contains('open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('focusin', event => {
      if (!(event.target as Element).closest('#tweaks-panel')) setOpen(false);
    });

    document.querySelectorAll<HTMLElement>('.tweak-option').forEach(option => {
      option.addEventListener('click', () => {
        const setting = option.dataset.setting as Setting;
        const value = option.dataset.value!;
        setActive(setting, value);
        localStorage.setItem(STORAGE_KEY(setting), value);

        if (setting === 'theme') applyTheme(value);
        else if (setting === 'lang') applyLang(value);
        else document.documentElement.setAttribute(`data-${setting}`, value);
      });
    });

    // 恢复保存的偏好
    (['theme', 'typeface', 'density', 'lang'] as Setting[]).forEach(setting => {
      const defaults = { theme: 'auto', typeface: 'sans', density: 'normal', lang: DEFAULT_LANG };
      const saved = localStorage.getItem(STORAGE_KEY(setting)) || defaults[setting];
      setActive(setting, saved);
      if (setting === 'theme') applyTheme(saved);
      else if (setting === 'lang') applyLang(saved);
      else document.documentElement.setAttribute(`data-${setting}`, saved);
    });

    // 当用户选了 auto 时，跟随系统主题变化
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (!localStorage.getItem(STORAGE_KEY('theme')) || localStorage.getItem(STORAGE_KEY('theme')) === 'auto') applyTheme('auto');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .tweaks-panel {
    position: fixed;
    bottom: max(16px, env(safe-area-inset-bottom));
    right: max(16px, env(safe-area-inset-right));
    z-index: 1000;
  }

  .tweaks-toggle {
    width: 44px;
    height: 44px;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: var(--ink);
    cursor: pointer;
    display: grid;
    place-items: center;
    font-size: 14px;
    transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;

    border: 0;
  }

  .tweaks-toggle:hover {
    transform: translateY(-1px);
    color: var(--accent);
    box-shadow: none;
    background: transparent;
  }

  .tweaks-toggle:active {
    transform: translateY(0);
  }

  .tweaks-menu {
    position: absolute;
    bottom: 46px;
    right: 0;
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    padding: 12px;
    width: 236px;
    max-width: calc(100vw - 32px);
    max-height: calc(100dvh - 90px);
    overflow-y: auto;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1), transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.2s;

  }

  .tweaks-menu.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .tweak-group {
    margin-bottom: 12px;
  }

  .tweak-group:last-child {
    margin-bottom: 0;
  }

  .tweak-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 8px;
    display: block;
    letter-spacing: 0.04em;
  }

  .tweak-options {
    display: flex;
    gap: 6px;
  }

  .tweak-option {
    flex: 1;
    min-width: 0;
    padding: 8px 10px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--muted);
    border-radius: 8px;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s, border-color 0.15s;
  }

  .tweak-option:hover {
    border-color: var(--ink-2);
    color: var(--ink);
    background: var(--panel);
  }

  .tweak-option.active {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .tweaks-toggle { position: relative; color: var(--muted); }
  .tweaks-toggle:focus-visible, .tweak-option:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (pointer: coarse) {
    .tweak-option { min-height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tweaks-toggle, .tweaks-menu, .tweak-option { transition: none; }
  }
</style>
