---
interface Props {
  title: string;
  description?: string;
  url: string;
}

const { title, description = '', url } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedDescription = encodeURIComponent(description);
const twitterUrl = `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`;
const weiboUrl = `https://service.weibo.com/share/share.php?url=${encodedUrl}&title=${encodedTitle}`;
const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=160x160&margin=10&data=${encodedUrl}`;
---

<section class="share-box" aria-label="分享文章">
  <div class="share-head">
    <h2>分享</h2>
    <span>share</span>
  </div>

  <div class="share-actions">
    <a href={twitterUrl} target="_blank" rel="noopener" aria-label="分享到 Twitter">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
      </svg>
      <span>Twitter</span>
    </a>
    <a href={weiboUrl} target="_blank" rel="noopener" aria-label="分享到微博">
      <span aria-hidden="true">微博</span>
    </a>
    <button type="button" class="copy-share" data-share-url={url} data-share-title={title} data-share-description={description} aria-label="复制文章链接">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.07 0l2.12-2.12a5 5 0 0 0-7.07-7.07L10.9 5.03M14 11a5 5 0 0 0-7.07 0L4.81 13.12a5 5 0 0 0 7.07 7.07l1.22-1.22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>复制链接</span>
    </button>
    <details class="qr-share">
      <summary aria-label="显示二维码">二维码</summary>
      <img src={qrUrl} alt={`二维码：${title}`} width="160" height="160" loading="lazy" decoding="async" />
    </details>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-share').forEach((button) => {
    button.addEventListener('click', async () => {
      const url = button.dataset.shareUrl;
      const title = button.dataset.shareTitle;
      const description = button.dataset.shareDescription;
      if (!url) return;

      try {
        if (navigator.share && title) {
          await navigator.share({ title, text: description, url });
        } else {
          await navigator.clipboard.writeText(url);
        }
        button.classList.add('copied');
        window.setTimeout(() => button.classList.remove('copied'), 1600);
      } catch {
        await navigator.clipboard.writeText(url);
      }
    });
  });
</script>

<style>
  .share-box {
    padding: 24px 0 12px;
    border-top: 1px solid var(--line);
  }

  .share-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
    font-family: var(--mono);
  }

  .share-head h2 {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .share-head h2::before {
    content: '// ';
    color: var(--muted-2);
  }

  .share-head span {
    color: var(--muted-2);
    font-size: 11px;
  }

  .share-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .share-actions a,
  .share-actions button,
  .qr-share summary {
    min-height: 30px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0 10px;
    font: 11.5px/1 var(--mono);
    text-decoration: none;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .share-actions a:hover,
  .share-actions button:hover,
  .qr-share summary:hover {
    color: var(--ink);
    border-color: var(--line-strong);
    background: var(--panel);
  }

  .share-actions svg {
    width: 14px;
    height: 14px;
  }

  .copy-share.copied span {
    color: var(--accent);
  }

  .qr-share {
    position: relative;
  }

  .qr-share summary {
    list-style: none;
  }

  .qr-share summary::-webkit-details-marker {
    display: none;
  }

  .qr-share img {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 20;
    width: 160px;
    height: 160px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: #fff;
    padding: 8px;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.12);
  }
</style>
