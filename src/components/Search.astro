---
import { t, DEFAULT_LANG } from '../utils/i18n';

interface Props {
  placeholder?: string;
}

const { placeholder = t('blog.searchPlaceholder', DEFAULT_LANG) } = Astro.props;
---

<div class="search-box">
  <form class="search" role="search">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
    <input
      type="text"
      id="search-input"
      placeholder={placeholder}
      aria-label={t('blog.searchPlaceholder', DEFAULT_LANG)}
      data-i18n-placeholder="blog.searchPlaceholder"
      data-i18n-aria-label="blog.searchPlaceholder"
      autocomplete="off"
    />

    <button id="clear-search" type="button" class="clear" aria-label={t('search.clear', DEFAULT_LANG)} data-i18n-aria-label="search.clear">×</button>
  </form>


</div>

<script>
  import { t, type Language } from '../utils/i18n';
  import { searchExcerpt } from '../utils/search';

  interface SearchPost {
    id: number; title: string; description: string; slug: string;
    published: string | null; tags: string[]; content: string;
  }
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const clear = document.querySelector<HTMLButtonElement>('#clear-search');
  const container = document.querySelector<HTMLElement>('#search-results');
  const list = container?.querySelector<HTMLElement>('.results-list');
  const count = container?.querySelector<HTMLElement>('.results-count');
  let data: SearchPost[] = [];
  let index: import('flexsearch').Document<SearchPost>;
  let loading: Promise<void> | undefined;
  let request = 0;
  const language = () => (document.documentElement.dataset.lang === 'en' ? 'en' : 'zh-CN') as Language;
  const escape = (text: string) => text.replace(/[&<>"']/g, char => ({'&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'}[char]!));
  function highlight(text: string, query: string) {
    const pos = text.toLocaleLowerCase().indexOf(query.toLocaleLowerCase());
    if (pos < 0) return escape(text);
    return `${escape(text.slice(0, pos))}<mark>${escape(text.slice(pos, pos + query.length))}</mark>${escape(text.slice(pos + query.length))}`;
  }
  async function load() {
    if (!loading) loading = (async () => {
      const [{ Document }, response] = await Promise.all([import('flexsearch'), fetch('/search-index.json')]);
      if (!response.ok) throw new Error('Search index unavailable');
      data = await response.json();
      index = new Document<SearchPost>({document: {id: 'id', index: ['title', 'description', 'content']}, tokenize: 'forward'});
      data.forEach(post => index.add(post));
    })().catch(error => { loading = undefined; throw error; });
    await loading;
  }
  async function search() {
    const version = ++request;
    const query = input?.value.trim() ?? '';
    if (!container || !list || !count || !clear) return;
    clear.style.display = query ? 'grid' : 'none';
    container.hidden = !query;
    const posts = document.getElementById('posts-list');
    if (posts) posts.hidden = Boolean(query);
    const timeline = document.querySelector<HTMLElement>('.timeline-side');
    if (timeline) timeline.hidden = Boolean(query);
    const sortControl = document.querySelector<HTMLElement>('.sort-control');
    if (sortControl) sortControl.hidden = Boolean(query);
    if (!query) return;
    count.textContent = t('search.loading', language());
    list.replaceChildren();
    try {
      await load();
      if (version !== request) return;
      const tag = new URL(location.href).searchParams.get('tag');
      const ids = new Set(index.search(query, {limit: data.length, suggest: true}).flatMap(result => result.result as number[]));
      // Literal matching also finds Chinese phrases inside unsegmented text.
      const needle = query.toLocaleLowerCase();
      const results = data.filter(post => (!tag || tag === 'all' || post.tags.includes(tag)) &&
        (ids.has(post.id) || [post.title, post.description, post.content, ...post.tags].some(text => text.toLocaleLowerCase().includes(needle)))).sort((a, b) => Number(b.title.toLocaleLowerCase().includes(needle)) - Number(a.title.toLocaleLowerCase().includes(needle)));
      count.textContent = t('search.resultsCount', language(), {count: results.length});
      list.innerHTML = results.length ? results.map(post => `
        <li class="result-item"><a href="${escape(post.slug)}" class="result-link">
          ${post.published ? `<time class="result-date" datetime="${escape(post.published)}">${new Date(post.published).toLocaleDateString(language())}</time>` : '<span class="result-date"></span>'}
          <div class="result-body"><h3 class="result-title">${highlight(post.title, query)}</h3>
          <p class="result-description">${highlight(searchExcerpt(post.content, query), query)}</p>
          <div class="result-tags">${post.tags.slice(0, 3).map(tag => `<span>#${escape(tag)}</span>`).join('')}</div></div>
          <span class="result-arrow" aria-hidden="true">→</span></a></li>`).join('')
        : `<li class="results-empty">${t('search.noResults', language())}</li>`;
    } catch {
      if (version === request) count.textContent = t('search.error', language());
    }
  }
  function updateQuery() {
    const url = new URL(location.href);
    const query = input?.value.trim();
    if (query) url.searchParams.set('q', query); else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    void search();
  }
  function restore() {
    if (input) input.value = new URL(location.href).searchParams.get('q') ?? '';
    void search();
  }
  input?.addEventListener('input', updateQuery);
  input?.addEventListener('focus', () => { if (input.value) void search(); });
  document.querySelector('.search')?.addEventListener('submit', event => { event.preventDefault(); updateQuery(); });
  clear?.addEventListener('click', () => { if (input) input.value = ''; updateQuery(); input?.focus(); });
  document.addEventListener('blog:filter', () => void search());
  document.addEventListener('i18n:change', () => void search());
  window.addEventListener('popstate', restore);

  input?.addEventListener('keydown', event => { if (event.key === 'Escape' && input) { input.value = ''; updateQuery(); } });
  restore();
</script>

<style>
  /* Search - matching Blog_writing.html */
  .search-box {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .search {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .search svg {
    position: absolute;
    left: 10px;
    width: 12px;
    height: 12px;
    color: var(--muted-2);
    pointer-events: none;
  }

  .search input {
    width: 100%;
    appearance: none;
    outline: 0;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    border-radius: 6px;
    height: 38px;
    padding: 0 30px 0 28px;
    font: 12px/1 var(--mono);
    letter-spacing: -.005em;
    transition: border-color .15s, background .15s;
  }

  .search input::placeholder {
    color: var(--muted-2);
  }

  .search input:hover {
    border-color: var(--line-strong);
  }

  .search input:focus {
    border-color: var(--ink);
    background: var(--bg);
  }

  .search .clear {
    position: absolute;
    right: 6px;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: var(--muted-2);
    display: none;
    grid-template-rows: 1fr;
    font: 12px/1 var(--mono);
    place-items: center;
  }

  .search .clear:hover {
    color: var(--ink);
    background: var(--panel);
  }

</style>
