<script>
  function isTypingTarget(target: EventTarget | null) {
    if (!(target instanceof HTMLElement)) return false;
    const tag = target.tagName;
    return target.isContentEditable || tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
  }

  function focusPost(delta: 1 | -1) {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('#posts-list .post h3 a'));
    if (!links.length) return false;

    const activeIndex = links.findIndex(link => link === document.activeElement);
    const nextIndex = activeIndex === -1
      ? (delta > 0 ? 0 : links.length - 1)
      : Math.max(0, Math.min(links.length - 1, activeIndex + delta));

    links[nextIndex]?.focus();
    return true;
  }

  document.addEventListener('keydown', (event) => {
    if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;

    if (event.key === 'Escape') {
      document.getElementById('search-results')?.setAttribute('hidden', '');
      document.querySelector('.tweaks-menu')?.classList.remove('open');
      return;
    }

    if (isTypingTarget(event.target)) return;

    if (event.key === '/') {
      const search = document.getElementById('search-input') as HTMLInputElement | null;
      if (!search) return;
      event.preventDefault();
      search.focus();
      search.select();
      return;
    }

    if (event.key === 'j' && focusPost(1)) event.preventDefault();
    if (event.key === 'k' && focusPost(-1)) event.preventDefault();
  });
</script>
